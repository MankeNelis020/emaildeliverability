# ── Server ───────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# Frontend URL (used for CORS and Stripe redirect URLs)
APP_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins (defaults to APP_URL)
# ALLOWED_ORIGINS=https://app.sendshield.nl,https://www.sendshield.nl

# ── Storage ───────────────────────────────────────────────────────────────────
# Where scan JSON files are stored (default: data/scans relative to project root)
# SCAN_STORE_DIR=/data/scans

# Where purchase JSON files are stored (default: data/purchases)
# PURCHASE_DIR=/data/purchases

# Where generated PDF files are stored (default: apps/runner/artifacts)
# SCAN_ARTIFACT_DIR=/data/artifacts

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs for each plan
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_VERIFIED=price_...

# ── Inbound email verification ────────────────────────────────────────────────
# Domain used for inbound test addresses: verify+{scanId}@{INBOUND_DOMAIN}
# Configure Postmark inbound webhook to POST to: https://api.yourdomain.nl/api/scan/inbound
INBOUND_DOMAIN=mail-verify.nl

# ── Integrations ─────────────────────────────────────────────────────────────
# Google Apps Script web app URL for the Sheets CRM webhook (optional)
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# Base URL of this API (used in Sheet CRM PDF links)
# API_BASE_URL=https://api.sendshield.nl
